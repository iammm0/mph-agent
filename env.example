# mph-agent 环境变量示例
# 复制为 .env 后填写实际值。不要将 .env 提交到仓库。

# =============================================================================
# LLM（桌面端仅开放 DeepSeek；CLI 仍可读其他后端）
# =============================================================================

# 推荐默认：deepseek
# 可选（CLI）: kimi | ollama | openai-compatible
LLM_BACKEND=deepseek

# ----- DeepSeek（桌面端必填）-----
DEEPSEEK_API_KEY=
# 可选：deepseek-flash（默认，更快）| deepseek-v4-pro（更强）
# 旧名 deepseek-chat / deepseek-reasoner / deepseek-v4-flash 已映射到 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# ----- 以下仅 CLI / 高级用途；桌面设置页不会写入 -----
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k

# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_MODEL=gpt-3.5-turbo

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# =============================================================================
# COMSOL + Java
# =============================================================================

# COMSOL 6.3 plugins 目录。留空时会尝试探测本机默认安装位置。
# Windows:
#   C:\Program Files\COMSOL\COMSOL63\Multiphysics\plugins
# macOS Apple Silicon:
#   /Applications/COMSOL63/Multiphysics/plugins
COMSOL_JAR_PATH=

# 含 JNI 的本地库目录（解决 UnsatisfiedLinkError: FlLicense.initWS0）。
# 可用分号（Windows）或冒号（Unix）拼接多个路径；留空则按 COMSOL_JAR_PATH 推导。
# Windows 示例（推荐同时含 lib 与 bin）:
#   C:\Program Files\COMSOL\COMSOL63\Multiphysics\lib\win64;C:\Program Files\COMSOL\COMSOL63\Multiphysics\bin\win64
# COMSOL_NATIVE_PATH=

# 可选：本地 COMSOL 文档目录，供 scripts/import_comsol_docs.py 建知识库；
# 未设置时回退到 COMSOL_JAR_PATH 附近的 doc。
# Windows 示例:
#   C:\Program Files\COMSOL\COMSOL63\Multiphysics\doc
# COMSOL_DOC_PATH=

# Java 安装目录。不设置时优先用系统 JAVA_HOME，否则首次使用可自动下载内置 JDK 11 到 runtime/java
# JAVA_HOME=

# 内置 JDK 下载镜像：留空用官方；国内可设 tsinghua（清华 TUNA）
# JAVA_DOWNLOAD_MIRROR=tsinghua

# 环境已就绪、禁止自动下载 JDK 时设为 1
# JAVA_SKIP_AUTO_DOWNLOAD=1

# 求解计算偏好（跑任务前可改；桌面端输入框底部徽章也可切换）
# auto = 有 GPU 则尝试（不支持的物理场自动回落 CPU）
# cpu  = 强制仅 CPU，不尝试 GPU
# gpu  = 优先尝试 GPU HardwareAcceleration（仍受 COMSOL 6.3 场景限制）
# COMSOL_COMPUTE_PREFERENCE=auto

# 可选：接入开源 MPh（https://github.com/MPh-py/MPh，Pythonic COMSOL 脚本）
# 用于参数读写、求解验收 evaluate、CSV/数据导出；不替代几何/物理场建模主链路。
# 安装：uv sync --extra mph
# 陷阱：uv sync / uv sync --extra dev 默认不装 MPh，还可能卸掉已装的 mph；
#       需要后处理时请用 uv sync --extra mph 或 uv sync --extra "dev,mph"。
# auto = 已安装则优先用于 export/evaluate；on = 强制尝试；off = 禁用
# MPH_BACKEND=auto

# =============================================================================
# 输出与日志
# =============================================================================

# 模型输出目录；不设置时默认为项目根目录下的 models
# MODEL_OUTPUT_DIR=

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# LiteLLM：默认用包内本地 model cost map，避免启动时访问 raw.githubusercontent.com
# （连不上时会出现 WinError 10054 警告，不影响调用，但会重试刷屏）
# LITELLM_LOCAL_MODEL_COST_MAP=True
