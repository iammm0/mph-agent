{
  "productName": "mph-agent",
  "mainBinaryName": "mph-agent",
  "version": "0.1.0",
  "identifier": "com.sensorai.mph-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "title": "mph-agent",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "mph-agent · 多物理场仿真建模智能体",
    "longDescription": "mph-agent 桌面端：围绕品牌 logo 与软件标识的多物理场仿真建模智能体。",
    "publisher": "mph-agent",
    "resources": ["resources/runtime/java"],
    "externalBin": ["binaries/mph-agent-bridge"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "mph-agent"
      }
    }
  }
}
